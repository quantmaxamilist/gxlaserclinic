---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { title?: string; treatment?: string }
const { title = 'Book your consultation', treatment } = Astro.props;
const href = treatment ? `/book?package=${treatment}` : '/book';
---
<section class="band rose" aria-labelledby="band-h">
  <div class="container band__in">
    <p class="label"><span class="dot" style="background:var(--c-noir)"></span>{site.name}</p>
    <h2 id="band-h" class="band__h" data-reveal>{title}</h2>
    <div class="band__actions" data-reveal>
      <a class="btn btn--dark" href={href}>Book online <Icon name="arrow" /></a>
      <a class="band__tel" href={site.phoneHref}><Icon name="phone" />{site.phone}</a>
    </div>
  </div>
</section>
<style>
  .band { padding: clamp(4rem, 3rem + 5vw, 8rem) 0; position: relative; overflow: hidden; }
  .band::after { content: 'GX'; position: absolute; right: -0.06em; bottom: -0.28em; font-family: var(--f-display); font-weight: 700; font-size: clamp(10rem, 28vw, 26rem); line-height: 1; letter-spacing: -0.06em; color: var(--c-noir); opacity: .07; pointer-events: none; }
  .band__in { position: relative; z-index: 1; display: grid; gap: var(--s-4); }
  .band__h { font-size: var(--fs-display-2); max-width: 14ch; }
  .band__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: center; }
  .band__tel { display: inline-flex; gap: .6rem; align-items: center; font-family: var(--f-mono); text-decoration: none; font-size: 1.05rem; }
  .band__tel :global(svg) { width: 18px; height: 18px; }
</style>
