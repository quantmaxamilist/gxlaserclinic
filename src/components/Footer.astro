---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, treatments, areas } from '../data/site';
const a = site.address;
---
<footer class="ftr dark">
  <div class="container">
    <div class="ftr__top">
      <Logo size={72} />
      <p class="ftr__bio">{site.headline}.</p>
    </div>
    <div class="ftr__grid">
      <div>
        <p class="label">Visit</p>
        <address>{a.street}<br />{a.locality}<br />{a.region} {a.postcode}</address>
        <a class="ftr__link" href={site.googleMaps} target="_blank" rel="noopener">Directions <Icon name="arrow" /></a>
      </div>
      <div>
        <p class="label">Contact</p>
        <a class="ftr__big" href={site.phoneHref}>{site.phone}</a>
        {site.email && <a class="ftr__link" href={`mailto:${site.email}`}>{site.email}</a>}
        <a class="ftr__link" href={site.instagram} target="_blank" rel="noopener"><Icon name="ig" />{site.instagramHandle}</a>
      </div>
      <div>
        <p class="label">Treatments</p>
        <ul>{treatments.map((t) => <li><a href={`/treatments/${t.slug}`}>{t.name}</a></li>)}</ul>
      </div>
      <div>
        <p class="label">Areas</p>
        <ul class="ftr__areas">{areas.slice(0, 10).map((t) => <li><a href={`/areas/${t.slug}`}>{t.name}</a></li>)}<li><a href="/areas">All areas</a></li></ul>
      </div>
    </div>
    <div class="ftr__base">
      <p>© {new Date().getFullYear()} {site.fullName}</p>
      <p><a href="/book">Book a consultation</a> · Site by <a href="https://quantweb.co.uk" rel="noopener">Quantweb</a></p>
    </div>
  </div>
</footer>
<style>
  .ftr { padding: var(--section) 0 var(--s-4); }
  .ftr__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--s-4); padding-bottom: var(--s-5); border-bottom: 1px solid var(--c-line-dark); color: var(--c-blush); }
  .ftr__bio { font-family: var(--f-display); font-style: italic; font-size: var(--fs-statement); color: var(--c-silver); }
  .ftr__grid { display: grid; gap: var(--s-5); padding: var(--s-5) 0; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); }
  .ftr .label { color: var(--c-rose); margin-bottom: var(--s-2); }
  address { font-style: normal; line-height: 1.7; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
  ul a, .ftr__base a { text-decoration: none; opacity: .8; }
  ul a:hover, .ftr__base a:hover { opacity: 1; color: var(--c-blush); }
  .ftr__big { display: block; font-family: var(--f-display); font-size: 1.7rem; text-decoration: none; color: var(--c-blush); margin-bottom: .5rem; }
  .ftr__link { display: inline-flex; gap: .45rem; align-items: center; margin-top: .6rem; text-decoration: none; font-size: .95rem; }
  .ftr__link :global(svg) { width: 16px; height: 16px; }
  .ftr__base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-2); padding-top: var(--s-4); border-top: 1px solid var(--c-line-dark); font-size: var(--fs-small); color: var(--c-silver-dim); }
</style>
