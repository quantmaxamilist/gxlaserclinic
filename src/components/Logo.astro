---
// GX monogram + "Laser Clinic" — taken from the embroidery on her clinic tunic
interface Props { size?: number; class?: string; stacked?: boolean }
const { size = 44, class: cls = '', stacked = true } = Astro.props;
---
<span class:list={['logo', cls, { 'logo--inline': !stacked }]} style={`--logo-size:${size}px`} aria-label="Gerrards Cross Laser Clinic — GX">
  <span class="logo__gx" aria-hidden="true">G<span class="logo__x">X</span></span>
  <span class="logo__sub" aria-hidden="true">Laser Clinic</span>
</span>
<style>
  .logo { display: inline-flex; flex-direction: column; align-items: center; line-height: 1; color: inherit; text-decoration: none; }
  .logo--inline { flex-direction: row; gap: .55em; align-items: baseline; }
  .logo__gx { font-family: var(--f-display); font-weight: 700; font-size: var(--logo-size); letter-spacing: -0.06em; font-variation-settings: 'opsz' 96; }
  .logo__x { margin-left: -0.04em; }
  .logo__sub { font-family: var(--f-display); font-style: italic; font-weight: 400; font-size: calc(var(--logo-size) * .3); letter-spacing: .04em; margin-top: .18em; opacity: .85; white-space: nowrap; }
  .logo--inline .logo__sub { margin-top: 0; font-size: calc(var(--logo-size) * .36); }
</style>
