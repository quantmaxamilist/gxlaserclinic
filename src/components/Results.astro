---
import Icon from './Icon.astro';
import { results, type Result } from '../data/site';
interface Props { items?: Result[]; title?: string; lead?: string; tone?: 'light' | 'dark'; showLink?: boolean; headingLevel?: 'h1' | 'h2' }
const { items = results, title = 'Real results', lead, tone = 'light', showLink = false, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
const id = 'res-' + Math.random().toString(36).slice(2, 7);
---
{items.length > 0 && (
<section class:list={['res section', tone === 'dark' ? 'dark' : 'paper']} aria-labelledby={id} data-results>
  <div class="container">
    <div class="sh sh--split">
      <div>
        <p class="label"><span class="dot"></span>Before &amp; after</p>
        <H id={id} data-reveal>{title}</H>
      </div>
      <p data-reveal>{lead ?? 'Real clients of the clinic, photographed before and after treatment. Results vary from person to person.'}</p>
    </div>
    <ul class="res__grid">
      {items.map((r, i) => (
        <li data-reveal>
          <button class="res__item" type="button" data-full={r.src} data-alt={r.alt} aria-label={`Enlarge: ${r.alt}`}>
            <img class:list={[{ fit: r.w !== r.h }]} src={r.src} width={r.w} height={r.h} alt={r.alt} loading="lazy" decoding="async" />
          </button>
          <p class="res__cap">
            {r.slug ? <a href={`/treatments/${r.slug}`}>{r.treatment}</a> : <span>{r.treatment}</span>}
            <span class="label">Before &amp; after</span>
          </p>
        </li>
      ))}
    </ul>
    {showLink && <a class="btn btn--dark res__more" href="/results">See all results <Icon name="arrow" /></a>}
  </div>
  <dialog class="res__lb" aria-label="Before and after photo">
    <button class="res__close" type="button" aria-label="Close">×</button>
    <img alt="" />
  </dialog>
</section>
)}
<style>
  .res .sh h2, .res .sh h1 { font-size: var(--fs-display-2); max-width: 14ch; }
  .dark.res .sh :is(h1,h2) { color: var(--c-paper); }
  .res__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .res__item { display: block; width: 100%; padding: 0; border: 0; background: var(--c-noir-2); border-radius: var(--radius-lg); overflow: hidden; cursor: zoom-in; aspect-ratio: 1; }
  .res__item img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease-out); }
  .res__item:hover img { transform: scale(1.03); }
  .res__item img.fit { object-fit: contain; }
  .res__cap { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: .7rem; }
  .res__cap a, .res__cap > span:first-child { font-family: var(--f-display); font-size: 1.25rem; text-decoration: none; }
  .res__cap a:hover { color: var(--c-rose-deep); }
  .res__cap .label { color: var(--c-ink-soft); white-space: nowrap; }
  .res__cap a, .res__cap > span:first-child { white-space: nowrap; }
  .dark .res__cap .label { color: var(--c-silver-dim); }
  .res__more { margin-top: var(--s-5); }
  .res__lb { border: 0; padding: 0; background: transparent; max-width: min(92vw, 1100px); max-height: 92vh; }
  .res__lb::backdrop { background: rgba(18,17,20,.88); }
  .res__lb img { display: block; max-width: 100%; max-height: 88vh; border-radius: 12px; }
  .res__close { position: absolute; top: 8px; right: 8px; width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgba(18,17,20,.7); color: #fff; font-size: 1.5rem; cursor: pointer; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-results]').forEach((sec) => {
    const dlg = sec.querySelector<HTMLDialogElement>('.res__lb');
    const img = dlg?.querySelector('img');
    if (!dlg || !img) return;
    sec.querySelectorAll<HTMLButtonElement>('.res__item').forEach((b) => b.addEventListener('click', () => {
      img.src = b.dataset.full || ''; img.alt = b.dataset.alt || ''; dlg.showModal();
    }));
    dlg.querySelector('.res__close')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });
  // block casual right-click saving on result photos
  document.addEventListener('contextmenu', (e) => { if ((e.target as Element).closest?.('.res__item, .res__lb')) e.preventDefault(); });
</script>
