---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, treatments } from '../data/site';
interface Props { title: string; description: string; schema?: object[]; noindex?: boolean }
const { title, description, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), site.url).href;
const a = site.address;
const business = {
  '@context': 'https://schema.org',
  '@type': ['MedicalClinic', 'BeautySalon'],
  '@id': `${site.url}/#clinic`,
  name: site.name,
  alternateName: [site.fullName, 'GX Laser Clinic'],
  description: site.headline + ' — laser hair removal, anti-wrinkle injections, advanced filler, facial profiling, Endolift and hair exosomes in Gerrards Cross, Buckinghamshire.',
  url: site.url,
  telephone: '+441753885598',
  image: `${site.url}/og.png`,
  priceRange: '££',
  address: { '@type': 'PostalAddress', streetAddress: a.street, addressLocality: a.locality, addressRegion: a.region, postalCode: a.postcode, addressCountry: a.country },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'], opens: '09:00', closes: '18:00' }],
  areaServed: ['Gerrards Cross','Chalfont St Peter','Beaconsfield','Denham','Iver','Stoke Poges','Amersham','Uxbridge','Slough','Buckinghamshire'],
  founder: { '@type': 'Person', name: site.owner },
  sameAs: [site.instagram],
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Treatments', itemListElement: treatments.map((t) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: t.name, url: `${site.url}/treatments/${t.slug}` } })) },
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#121114" />
    <meta name="geo.region" content="GB-BKM" />
    <meta name="geo.placename" content="Gerrards Cross" />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script type="application/ld+json" set:html={JSON.stringify([business, ...schema])} />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <div class="cursor" aria-hidden="true"><span class="cursor__ring"></span><span class="cursor__dot"></span></div>
    <div class="curtain" aria-hidden="true"></div>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
